# Sample .env. The reference for every variable (default, required, meaning)
# is docs/ENVIRONMENT.md (#1432).

# Stellar network to connect to: testnet or mainnet
STELLAR_NETWORK=testnet

# RPC URL for the Stellar network (required for mainnet, optional for testnet - defaults to testnet RPC)
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Horizon URL for the Stellar network (optional - defaults to testnet/mainnet horizon)
# HORIZON_URL=https://horizon-testnet.stellar.org

# Contract IDs (all required)
# Testnet values shown below - replace with your deployed contract IDs
ORACLE_CONTRACT_ID=CBEMTV23SIJJBIST3V5HTMWHR4MHYGHNBIG4M26U4LGUJTWZXTFSVQEY
ROLE_STORE=CBSUAIAMIFFS4AXQYZ7KR7FNO7IMKAPS5WF4DXANVXDTPKH2F7YUIN6Q
DATA_STORE=CCZ3VKBEDLNBO2JM3EXL3SNBDJOV5BTN52FVQPER7F6D5GCE53PITQ3J
ORDER_HANDLER=CC35OFZVWUTAZPV3B6UKSDVAVORZEWUUMOMTHO33H4YR4C5FKPEFODKY
DEPOSIT_HANDLER=CDWOFIP4YQJGMCYAOWLSRBAWN2OTJUG2I5WOFC32O2TX2SRU56RWBE5C
WITHDRAWAL_HANDLER=CCA5HRHMG6E6BVYRICSLZ5CK5KNPAAKXQ7XWDM34WWVGNHWHA26GRVVE
READER=CC6OZUHF3LVO6PNP3V2EB36ORB3YSVYSH3LWD3RFLO4NUO3BYCXSWSYC

# Keeper account credentials (all required)
# Raw hex-encoded Ed25519 seed (32 bytes = 64 hex chars) for the keeper Stellar signing account
KEEPER_PRIVATE_KEY=1111111111111111111111111111111111111111111111111111111111111111
# Secret key in Strkey format (S-prefixed, 56 chars) - distinct from KEEPER_PRIVATE_KEY
KEEPER_SECRET_KEY=SAIRCEIRCEIRCEIRCEIRCEIRCEIRCEIRCEIRCEIRCEIRCEIRCEIRDBNT
# Public account ID (G-prefixed, 56 chars) derived from the seed above
KEEPER_ACCOUNT_ID=GAUHMCMUP5FZO5675W3ISZ6E6CNYJGXBUW5WANE2JR4TGAARYCTSCBKI

# Optional: Keeper index for multi-keeper setups (default: 0)
KEEPER_INDEX=0

# Optional: Secret token for the admin API endpoints (if unset, admin endpoints return 503).
# Must be at least 32 characters; the placeholder below is rejected at startup.
# Generate one with: openssl rand -hex 32
ADMIN_API_TOKEN=your-admin-api-token-here

# Optional: API key for the production Pyth Hermes endpoint. A secret — set it
# with `fly secrets set` / a Railway sealed variable, never in a manifest.
# PYTH_API_KEY=

# Optional: price-source base URLs. Defaults are the production providers;
# override for local mock servers / integration tests (#1264).
# COINBASE_BASE_URL=https://api.coinbase.com/v2/exchange-rates?currency=
# BINANCE_BASE_URL=https://data-api.binance.vision/api/v3/ticker/price
# PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes/api/latest_price_feeds

# Optional: Minimum keeper balance in XLM (default: 10.0). 0 disables the balance gate (local testing only; logged as a warning at startup)
MIN_KEEPER_BALANCE_XLM=10.0

# Optional: inclusion fees in stroops, 1 to 10000000 (1 XLM) each (defaults: 1000000 for set_prices,
# 2000000 for keeper handler transactions)
# SET_PRICES_TX_FEE=1000000
# KEEPER_TX_FEE=2000000

# Optional: Price loop interval in milliseconds (default: 1000)
PRICE_LOOP_MS=1000

# Optional: Keeper loop interval in milliseconds (default: 1500)
KEEPER_LOOP_MS=1500

# Optional: Address and port the HTTP server binds to (serves both the public price feed and the admin API) (default: 0.0.0.0:8080)
BIND_ADDR=0.0.0.0:8080

# Test-only overrides for exchange price endpoints. Leave unset in production;
# they default to the real Coinbase/Binance URLs. Useful when pointing
# integration tests at a local mock server.
# COINBASE_BASE_URL=http://127.0.0.1:9001/v2/exchange-rates?currency=
# BINANCE_BASE_URL=http://127.0.0.1:9002/api/v3/ticker/price

# Price feed configuration (optional - defaults to config/tokens.json)
# PRICE_FEED_CONFIG=[{"symbol":"BTC","stellar_address":"...","sources":["binance","coinbase","pyth"],"binance_symbol":"BTCUSDT","coinbase_symbol":"BTC","pyth_feed_id":"...","min_sources":2}]

# Optional: log filter (default: info). Standard tracing EnvFilter syntax; an
# unparseable value falls back to info with a warning at startup.
# Useful values: info | oracle=debug,tower_http=debug
# RUST_LOG=info

# Optional: log output format (default: json). `json` is one structured object
# per line for log pipelines; `pretty` is human-readable for local development.
# LOG_FORMAT=json
