# Stellar network to connect to: testnet or mainnet
STELLAR_NETWORK=testnet

# RPC URL for the Stellar network (required for mainnet, optional for testnet - defaults to testnet RPC)
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Horizon URL for the Stellar network (optional - defaults to testnet/mainnet horizon)
# HORIZON_URL=https://horizon-testnet.stellar.org

# Contract IDs (all required)
# Testnet values shown below - replace with your deployed contract IDs
ORACLE_CONTRACT_ID=CBEMTV23SIJJBIST3V5HTMWHR4MHYGHNBIG4M26U4LGUJTWZXTFSVQEY
ROLE_STORE=CBSUAIAMIFFS4AXQYZ7KR7FNO7IMKAPS5WF4DXANVXDTPKH2F7YUIN6Q
DATA_STORE=CCZ3VKBEDLNBO2JM3EXL3SNBDJOV5BTN52FVQPER7F6D5GCE53PITQ3J
ORDER_HANDLER=CC35OFZVWUTAZPV3B6UKSDVAVORZEWUUMOMTHO33H4YR4C5FKPEFODKY
DEPOSIT_HANDLER=CDWOFIP4YQJGMCYAOWLSRBAWN2OTJUG2I5WOFC32O2TX2SRU56RWBE5C
WITHDRAWAL_HANDLER=CCA5HRHMG6E6BVYRICSLZ5CK5KNPAAKXQ7XWDM34WWVGNHWHA26GRVVE
READER=CC6OZUHF3LVO6PNP3V2EB36ORB3YSVYSH3LWD3RFLO4NUO3BYCXSWSYC

# Keeper account credentials (all required)
# Raw hex-encoded Ed25519 seed (32 bytes = 64 hex chars) for the keeper Stellar signing account
KEEPER_PRIVATE_KEY=1111111111111111111111111111111111111111111111111111111111111111
# Secret key in Strkey format (S-prefixed, 56 chars) - distinct from KEEPER_PRIVATE_KEY
KEEPER_SECRET_KEY=SAUHMCMUP5FZO5675W3ISZ6E6CNYJGXBUW5WANE2JR4TGAARYCTSCBKI
# Public account ID (G-prefixed, 56 chars) derived from the seed above
KEEPER_ACCOUNT_ID=GAUHMCMUP5FZO5675W3ISZ6E6CNYJGXBUW5WANE2JR4TGAARYCTSCBKI

# Optional: Keeper index for multi-keeper setups (default: 0)
KEEPER_INDEX=0

# Optional: Secret token for the admin API endpoints (if unset, admin endpoints return 503)
ADMIN_API_TOKEN=your-admin-api-token-here

# Optional: Minimum keeper balance in XLM (default: 10.0)
MIN_KEEPER_BALANCE_XLM=10.0

# Optional: Price loop interval in milliseconds (default: 1000)
PRICE_LOOP_MS=1000

# Optional: Keeper loop interval in milliseconds (default: 1500)
KEEPER_LOOP_MS=1500

# Optional: Bind address for the admin API server (default: 0.0.0.0:8080)
BIND_ADDR=0.0.0.0:8080

# Price feed configuration (optional - defaults to config/tokens.json)
# PRICE_FEED_CONFIG=[{"symbol":"BTC","stellar_address":"...","sources":["binance","coinbase","pyth"],"binance_symbol":"BTCUSDT","coinbase_symbol":"BTC","pyth_feed_id":"...","min_sources":2}]
