# Copy this file to .env and fill in real values before running the oracle locally.
# .env is ignored by git; keep real secrets out of commits.

# Network selection: "testnet" (default) or "mainnet"
STELLAR_NETWORK=testnet

# Optional: Host bind address for the API server (default: 0.0.0.0:8080)
BIND_ADDR=0.0.0.0:8080

# Raw 64-character hex-encoded Ed25519 seed for the keeper Stellar signing account.
KEEPER_PRIVATE_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f

# Stellar public key (G...) of the keeper account derived from the seed above.
KEEPER_ACCOUNT_ID=GBZXN7PIRZGNMHGA72CSUFOHBTFDPR25O4CQHX2LQYW4F5QXBSGXYPWF

# Secret token for the admin API endpoints.
ADMIN_API_TOKEN=your-secure-admin-token-here

# Protocol Contract IDs (Soroban contract addresses starting with C...)
ORACLE_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2KM
ROLE_STORE=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2KM
DATA_STORE=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2KM
ORDER_HANDLER=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2KM
DEPOSIT_HANDLER=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2KM
WITHDRAWAL_HANDLER=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2KM
READER=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2KM

# Optional RPC and Horizon endpoint overrides (defaults provided for testnet)
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# HORIZON_URL=https://horizon-testnet.stellar.org

# JSON array of price feed configurations.
#
# Leave this UNSET for local development — the oracle then loads the embedded
# config/tokens.json sample tokens. Setting it to an empty array (PRICE_FEED_CONFIG=[])
# is NOT the same as leaving it unset: an empty array configures zero tokens, so
# the service starts cleanly but never fetches or caches any prices and GET /prices 503s.
#
# To override the embedded sample, set a populated JSON array, e.g.:
#   PRICE_FEED_CONFIG=[{"symbol":"TUSDC","sources":["fixed"],"fixed_price":"1000000000000000000000000000000","min_sources":1,"max_deviation_bps":100,"stale_after_seconds":60,"submit_threshold_bps":10}]