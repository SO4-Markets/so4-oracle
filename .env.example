# Copy this file to .env and fill in real values before running the oracle locally.
# .env is ignored by git; keep real secrets out of commits.

# Raw hex-encoded Ed25519 seed for the keeper Stellar signing account.
KEEPER_PRIVATE_KEY_HEX=<your-64-char-hex-ed25519-seed>

# Stellar public key (G...) of the keeper account derived from the seed above.
KEEPER_ACCOUNT_ID=<your-stellar-account-id>

# Secret token for the admin API endpoints.
ADMIN_API_TOKEN=<your-admin-api-token>

# JSON array of price feed configurations.
#
# Leave this UNSET (as it is here) for local development — the oracle then
# loads the embedded config/tokens.json sample tokens. Setting it to an empty
# array (PRICE_FEED_CONFIG=[]) is NOT the same as leaving it unset: an empty
# array is a valid, present value that configures zero tokens, so the service
# starts cleanly but never fetches or caches any prices and GET /prices always
# 503s.
#
# To override the embedded sample, set a populated JSON array (see README for
# the schema), e.g.:
#   PRICE_FEED_CONFIG=[{"symbol":"TUSDC","sources":["fixed"],"fixed_price":"1000000000000000000000000000000","min_sources":1,"max_deviation_bps":100,"stale_after_seconds":60,"submit_threshold_bps":10}]