{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "/app/oracle",
    "healthcheckPath": "/ready",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 100
  },
  "variables": {
    "PORT": "8080",
    "BIND_ADDR": "0.0.0.0:8080",
    "STELLAR_NETWORK": "YOUR_STELLAR_NETWORK",
    "STELLAR_RPC_URL": "YOUR_STELLAR_RPC_URL",
    "ORACLE_CONTRACT_ID": "YOUR_ORACLE_CONTRACT_ID",
    "ROLE_STORE": "YOUR_ROLE_STORE_CONTRACT_ID",
    "DATA_STORE": "YOUR_DATA_STORE_CONTRACT_ID",
    "ORDER_HANDLER": "YOUR_ORDER_HANDLER_CONTRACT_ID",
    "DEPOSIT_HANDLER": "YOUR_DEPOSIT_HANDLER_CONTRACT_ID",
    "WITHDRAWAL_HANDLER": "YOUR_WITHDRAWAL_HANDLER_CONTRACT_ID",
    "READER": "YOUR_READER_CONTRACT_ID",
    "KEEPER_PRIVATE_KEY": "YOUR_KEEPER_PRIVATE_KEY_HEX",
    "KEEPER_SECRET_KEY": "YOUR_KEEPER_SECRET_KEY",
    "KEEPER_ACCOUNT_ID": "YOUR_KEEPER_ACCOUNT_ID",
    "ADMIN_API_TOKEN": "YOUR_ADMIN_API_TOKEN",
    "PRICE_LOOP_MS": "1000",
    "KEEPER_LOOP_MS": "1500",
    "MIN_KEEPER_BALANCE_XLM": "10",
    "KEEPER_INDEX": "0"
  }
}
